<!doctype html>
<html lang="<%= language %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>MSSQLBackupTool</title>
  <script>
    try {
      const savedTheme = document.cookie.match(/(?:^|;\s*)theme=(dark|light)(?:;|$)/)?.[1];
      const theme = savedTheme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const accent = document.cookie.match(/(?:^|;\s*)accent=(red|blue)(?:;|$)/)?.[1] ?? 'blue';
      document.documentElement.dataset.theme = theme;
      document.documentElement.dataset.accent = accent;
    } catch {}
  </script>
  <link rel="stylesheet" href="/public/app.css">
  <script src="https://unpkg.com/htmx.org@2.0.10"></script>
  <script id="client-i18n" type="application/json"><%- clientCatalogJson %></script>
  <script src="/public/app.js" defer></script>
</head>
<body>
  <header class="topbar">
    <div><span class="product-mark">MS</span><strong>MSSQLBackupTool</strong></div>
    <div class="topbar__actions">
      <span class="environment"><%= t('header.environment') %></span>
      <form class="language-form" action="/language" method="post" data-language-form>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="visually-hidden" for="ui-language"><%= t('language.label') %></label>
        <span id="language-hint" class="visually-hidden"><%= t('language.reloadHint') %></span>
        <select id="ui-language" class="language-select" name="language" aria-describedby="language-hint">
          <% for (const [code, name] of Object.entries(languages)) { %><option value="<%= code %>" lang="<%= code %>"<% if (code === language) { %> selected<% } %>><%= name %></option><% } %>
        </select>
        <button class="button language-submit" type="submit" aria-label="<%= t('language.apply') %>" title="<%= t('language.apply') %>"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12l4 4L19 6"/></svg></button>
      </form>
      <button class="accent-toggle" type="button" data-accent-toggle aria-label="<%= t('client.accent.switchToRed') %>" aria-pressed="true" title="<%= t('client.accent.switchToRed') %>"><span class="accent-toggle__swatch" aria-hidden="true"></span></button>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="<%= t('client.theme.enableDark') %>" aria-pressed="false" title="<%= t('client.theme.enableDark') %>"><span class="theme-toggle__light" aria-hidden="true">☀</span><span class="theme-toggle__dark" aria-hidden="true">☾</span></button>
    </div>
  </header>
  <main class="workspace">
    <%- include('partials/operation-status', { operation }) %>
    <div class="forms-grid">
      <section class="panel">
        <h1><%= t('backup.title') %></h1>
        <form hx-post="/operations/backup" hx-target="#operation-dialog-host" hx-swap="outerHTML">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label for="databaseName"><%= t('backup.database') %></label>
          <select id="databaseName" name="databaseName" required><% for (const database of databases) { %><option><%= database %></option><% } %></select>
          <fieldset><legend><%= t('backup.compression') %></legend>
            <label><input type="radio" name="compression" value="none" checked> <%= t('backup.compression.none') %></label>
            <label><input type="radio" name="compression" value="native"> <%= t('backup.compression.native') %></label>
            <label><input type="radio" name="compression" value="zip"> ZIP</label><label><input type="radio" name="compression" value="gzip"> GZIP</label><label><input type="radio" name="compression" value="7z"> 7Z</label>
          </fieldset>
          <button class="button button--primary" type="submit"><%= t('backup.submit') %></button>
        </form>
      </section>
      <section class="panel">
        <h2><%= t('restore.title') %></h2>
        <form hx-post="/operations/restore" hx-target="#operation-dialog-host" hx-swap="outerHTML">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label for="restoreFilename"><%= t('restore.backupFile') %></label>
          <select id="restoreFilename" name="filename" required><% for (const file of files) { %><option><%= file.name %></option><% } %></select>
          <fieldset><legend><%= t('restore.targetMode') %></legend><label><input type="radio" name="targetMode" value="new" checked> <%= t('restore.targetMode.new') %></label><label><input type="radio" name="targetMode" value="existing"> <%= t('restore.targetMode.existing') %></label></fieldset>
          <label id="target-database-label" for="targetDatabaseInput"><%= t('restore.targetDatabase') %></label>
          <input id="targetDatabaseInput" name="targetDatabase" list="database-options" maxlength="128" required aria-labelledby="target-database-label">
          <select id="targetDatabaseSelect" name="targetDatabase" style="display:none;" aria-hidden="true" aria-labelledby="target-database-label" required></select>
          <datalist id="database-options"><% for (const database of databases) { %><option value="<%= database %>"></option><% } %></datalist>
          <div class="warning"><strong><%= t('common.warning') %></strong> <%= t('restore.overwriteIrreversible') %></div>
          <label><input type="checkbox" name="allowOverwrite"> <%= t('restore.allowOverwrite') %></label><label><input type="checkbox" name="disconnectUsers"> <%= t('restore.disconnectUsers') %></label>
          <div class="button-row"><button class="button button--secondary" type="submit" formaction="/operations/verify" hx-post="/operations/verify"><%= t('restore.verify') %></button><button class="button button--primary" type="submit"><%= t('restore.verifyAndRestore') %></button></div>
        </form>
      </section>
    </div>
    <section class="files-section">
      <div class="section-heading"><div><h2><%= t('files.title') %></h2><p id="file-count"><%= t('files.sharedVolumeCount', { count: formatNumber(files.length) }) %></p></div>
        <div class="section-tools"><form class="upload" enctype="multipart/form-data" hx-post="/files/upload" hx-target="#operation-dialog-host" hx-swap="outerHTML">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="button button--primary file-picker"><span class="file-picker__text"><%= t('files.upload.choose') %></span><input type="file" name="backupFile" accept=".bak,.zip,.gz,.7z" required></label>
          <div class="upload-progress" hidden aria-live="polite"><span><%= t('files.upload.progressLabel') %> <strong class="upload-progress__value"><%= formatPercent(0) %></strong></span><progress value="0" max="100"><%= formatPercent(0) %></progress></div>
        </form><button class="refresh-button" type="button" title="<%= t('files.refresh.title') %>" aria-label="<%= t('files.refresh.aria') %>" hx-get="/partials/files" hx-target="#files-section-data" hx-swap="outerHTML"><span class="refresh-button__icon" aria-hidden="true">↻</span></button></div>
      </div><div id="files-section-data"><%- include('partials/file-table', { files, csrfToken, oob: false }) %></div>
    </section>
    <section class="database-section" aria-labelledby="database-section-title">
      <div class="section-heading"><div><h2 id="database-section-title"><%= t('databases.title') %></h2><p><%= t('databases.description') %></p></div><div class="section-tools"><span id="database-count" class="count-badge"><%= databasesAvailable ? formatNumber(databaseDetails.length) : '—' %></span><button class="refresh-button" type="button" title="<%= t('databases.refresh') %>" aria-label="<%= t('databases.refresh') %>" hx-get="/partials/databases" hx-target="#database-table-wrap" hx-swap="outerHTML"><span class="refresh-button__icon" aria-hidden="true">↻</span></button></div></div>
      <% if (enableShrinkLog) { %><div class="database-warning"><strong><%= t('common.warning') %></strong> <%= t('databases.shrink.aggressiveWarning') %></div><% } %>
      <%- include('partials/database-data', { databaseDetails, databasesAvailable, csrfToken, enableShrinkLog, oob: false }) %>
    </section>
    <%- include('partials/sql-environment', { sqlEnvironment: { ...sqlEnvironment, target: sqlEnvironment.target ?? t('environment.notConfigured') } }) %>
  </main>
  <dialog class="operation-dialog rename-dialog" id="rename-dialog" aria-labelledby="rename-dialog-title" aria-describedby="rename-dialog-description">
    <form method="post" hx-post="/files/rename" hx-target="#operation-dialog-host" hx-swap="outerHTML" data-rename-form novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="filename" id="rename-original-filename" value="">
      <div class="operation-dialog__header">
        <span class="status-dot" aria-hidden="true"></span>
        <div><h2 id="rename-dialog-title"><%= t('files.rename.dialogTitle') %></h2><p id="rename-dialog-description"><%= t('files.rename.dialogDescription') %></p></div>
      </div>
      <div class="rename-dialog__body">
        <label for="rename-new-base"><%= t('files.rename.fieldLabel') %></label>
        <div class="rename-dialog__filename"><input id="rename-new-base" name="newBase" type="text" required maxlength="190" aria-describedby="rename-dialog-description rename-suffix rename-error"><span id="rename-suffix" class="rename-dialog__suffix" aria-label="<%= t('files.rename.suffixLabel') %>"></span></div>
        <p id="rename-error" class="field-error" aria-live="polite"></p>
      </div>
      <div class="operation-dialog__footer rename-dialog__actions"><button class="button button--secondary" type="button" data-rename-cancel><%= t('common.cancel') %></button><button class="button button--primary" type="submit"><%= t('files.rename.action') %></button></div>
    </form>
  </dialog>

  <dialog class="operation-dialog compress-dialog" id="compress-dialog" aria-labelledby="compress-dialog-title" aria-describedby="compress-dialog-description">
    <form method="post" hx-post="/files/compress" hx-target="#operation-dialog-host" hx-swap="outerHTML" data-compress-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="filename" id="compress-filename" value="">
      <div class="operation-dialog__header">
        <span class="status-dot" aria-hidden="true"></span>
        <div><h2 id="compress-dialog-title"><%= t('files.compress.dialogTitle') %></h2><p id="compress-dialog-description"><%= t('files.compress.dialogDescription') %></p></div>
      </div>
      <fieldset class="compress-dialog__formats">
        <legend><%= t('files.compress.menu.options') %></legend>
        <% for (const archiveFormat of [{ value: 'zip', label: 'ZIP' }, { value: 'gzip', label: 'GZIP' }, { value: '7z', label: '7Z' }]) { %>
          <label class="compress-format"><input type="radio" name="format" value="<%= archiveFormat.value %>" <%= archiveFormat.value === 'zip' ? 'checked' : '' %>><span><strong><%= archiveFormat.label %></strong><small><%= t(`files.compress.${archiveFormat.value}.tooltip`) %></small></span></label>
        <% } %>
      </fieldset>
      <div class="operation-dialog__footer compress-dialog__actions"><button class="button button--secondary" type="button" data-compress-cancel><%= t('common.cancel') %></button><button class="button button--primary" type="submit"><%= t('files.compress.action') %></button></div>
    </form>
  </dialog>

  <dialog class="operation-dialog confirmation-dialog" data-confirm-dialog aria-labelledby="confirm-dialog-title" aria-describedby="confirm-dialog-message"><div class="operation-dialog__header"><span class="status-dot" aria-hidden="true"></span><div><h2 id="confirm-dialog-title" tabindex="-1"><%= t('confirmation.defaultTitle') %></h2><p id="confirm-dialog-message"></p></div><span class="operation-dialog__state"><%= t('confirmation.state') %></span></div><div class="operation-dialog__footer confirmation-dialog__actions"><button class="button button--secondary" type="button" data-confirm-cancel><%= t('common.cancel') %></button><button class="button button--danger" type="button" data-confirm-accept><%= t('common.confirm') %></button></div></dialog>
</body>
</html>