<div id="database-table-wrap" class="table-wrap database-table-wrap"<% if (oob) { %> hx-swap-oob="outerHTML"<% } %>>
  <table class="database-table">
    <caption>Bazy danych i ich parametry administracyjne</caption>
    <thead><tr>
      <th scope="col">Baza</th><th scope="col">Stan</th><th scope="col">Dane</th><th scope="col">Log</th>
      <th scope="col">Razem</th><th scope="col">Połączenia</th><th scope="col">Model</th>
      <th scope="col">Ostatni pełny backup</th><th scope="col">Akcje</th>
    </tr></thead>
    <tbody>
      <% if (!databasesAvailable) { %><tr><td colspan="9" class="empty">Lista baz jest niedostępna — sprawdź połączenie z SQL Serverem.</td></tr>
      <% } else if (!databaseDetails.length) { %><tr><td colspan="9" class="empty">Brak baz użytkownika.</td></tr><% } %>
      <% for (const [databaseIndex, database] of databaseDetails.entries()) { const canShrink = enableShrinkLog && database.state === 'ONLINE' && !database.isReadOnly; %>
        <tr>
          <th scope="row" title="<%= database.name %>"><%= database.name %></th>
          <td><span class="state-badge state-badge--<%= database.state === 'ONLINE' ? 'online' : 'other' %>"><%= database.state %></span></td>
          <td class="numeric"><%= formatBytes(database.dataSizeBytes) %></td>
          <td class="numeric" title="Pliki LDF: <%= database.logFileCount %>; oczekiwanie na ponowne użycie: <%= database.logReuseWait || '—' %>"><%= formatBytes(database.logSizeBytes) %></td>
          <td class="numeric"><%= formatBytes(database.totalSizeBytes) %></td>
          <td class="numeric"><%= database.activeConnections ?? '—' %></td>
          <td><%= database.recoveryModel || '—' %></td>
          <td><% if (database.lastFullBackupAt) { %><time datetime="<%= new Date(database.lastFullBackupAt).toISOString() %>"><%= new Date(database.lastFullBackupAt).toLocaleString('pl-PL') %></time><% } else { %>—<% } %></td>
          <td><div class="actions database-actions">
            <% if (canShrink) { %>
              <form class="action-with-tooltip" hx-post="/databases/shrink-log" hx-target="#operation-dialog-host" hx-swap="outerHTML"
                hx-confirm="Zwolnić nieaktywny koniec logu bazy '<%= database.name %>'? Operacja może nie odzyskać miejsca, jeśli końcowe fragmenty logu są aktywne."
                data-confirm-variant="warning" data-confirm-title="Zmniejszyć log bazy?" data-confirm-action="Zmniejsz log">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="databaseName" value="<%= database.name %>">
                <input type="hidden" name="mode" value="safe"><input type="hidden" name="confirmShrinkLog" value="yes">
                <button class="button icon-button button--warning" type="submit" aria-label="Zwolnij nieaktywny koniec logu bazy <%= database.name %>" aria-describedby="safe-shrink-tip-<%= databaseIndex %>">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><ellipse cx="12" cy="5" rx="7" ry="3"/><path d="M5 5v6c0 1.7 3.1 3 7 3s7-1.3 7-3V5M5 11v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"/><path d="m9 8 3 3 3-3"/></svg>
                </button>
                <span id="safe-shrink-tip-<%= databaseIndex %>" class="action-tooltip" role="tooltip">Zwolnij nieaktywny koniec logu</span>
              </form>
              <form class="action-with-tooltip" hx-post="/databases/shrink-log" hx-target="#operation-dialog-host" hx-swap="outerHTML"
                hx-confirm="UWAGA: baza '<%= database.name %>' zostanie czasowo przełączona na SIMPLE, a każdy LDF zmniejszony do 256 MB. Przerwie to łańcuch backupów logu. Kontynuować?"
                data-confirm-variant="danger" data-confirm-title="Agresywnie zmniejszyć log?" data-confirm-action="Zmniejsz agresywnie">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="databaseName" value="<%= database.name %>">
                <input type="hidden" name="mode" value="aggressive"><input type="hidden" name="confirmShrinkLog" value="yes">
                <button class="button icon-button button--warning-strong" type="submit" aria-label="Agresywnie zmniejsz log bazy <%= database.name %> do 256 MB na plik LDF" aria-describedby="aggressive-shrink-tip-<%= databaseIndex %>">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><ellipse cx="12" cy="5" rx="7" ry="3"/><path d="M5 5v6c0 1.7 3.1 3 7 3s7-1.3 7-3V5M5 11v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"/><path d="m8 8 4 4 4-4M9 13l3 3 3-3"/></svg>
                </button>
                <span id="aggressive-shrink-tip-<%= databaseIndex %>" class="action-tooltip" role="tooltip">Agresywnie zmniejsz do 256 MB/LDF</span>
              </form>
            <% } %>
            <form class="action-with-tooltip" hx-post="/databases/delete" hx-target="#operation-dialog-host" hx-swap="outerHTML"
              hx-confirm="Czy na pewno usunąć bazę '<%= database.name %>'? Wszystkie dane zostaną bezpowrotnie utracone."
              data-confirm-variant="danger" data-confirm-title="Usunąć bazę danych?" data-confirm-action="Usuń bazę">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="databaseName" value="<%= database.name %>">
              <input type="hidden" name="confirmDelete" value="yes">
              <button class="button icon-button button--danger" type="submit" aria-label="Usuń bazę <%= database.name %>" aria-describedby="delete-tip-<%= databaseIndex %>">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h16M9 7V4h6v3M7 7l1 13h8l1-13M10 11v5M14 11v5"/></svg>
              </button>
              <span id="delete-tip-<%= databaseIndex %>" class="action-tooltip" role="tooltip">Usuń bazę danych</span>
            </form>
          </div></td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
<% if (oob) { %><span id="database-count" class="count-badge" hx-swap-oob="outerHTML"><%= databasesAvailable ? databaseDetails.length : '—' %></span><% } %>
