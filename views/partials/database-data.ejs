<div id="database-table-wrap" class="table-wrap database-table-wrap"<% if (oob) { %> hx-swap-oob="outerHTML"<% } %>>
  <table class="database-table">
    <caption><%= t('databases.table.caption') %></caption>
    <thead><tr>
      <th scope="col"><%= t('databases.table.database') %></th><th scope="col"><%= t('databases.table.state') %></th><th scope="col"><%= t('databases.table.dataSize') %></th><th scope="col"><%= t('databases.table.logSize') %></th>
      <th scope="col"><%= t('databases.table.totalSize') %></th><th scope="col"><%= t('databases.table.connections') %></th><th scope="col"><%= t('databases.table.recoveryModel') %></th>
      <th scope="col"><%= t('databases.table.lastFullBackup') %></th><th scope="col"><%= t('common.actions') %></th>
    </tr></thead>
    <tbody>
      <% if (!databasesAvailable) { %><tr><td colspan="9" class="empty"><%= t('databases.table.unavailable') %></td></tr>
      <% } else if (!databaseDetails.length) { %><tr><td colspan="9" class="empty"><%= t('databases.table.empty') %></td></tr><% } %>
      <% for (const [databaseIndex, database] of databaseDetails.entries()) { const canShrink = enableShrinkLog && database.state === 'ONLINE' && !database.isReadOnly; %>
        <tr>
          <th scope="row" title="<%= database.name %>"><%= database.name %></th>
          <td><span class="state-badge state-badge--<%= database.state === 'ONLINE' ? 'online' : 'other' %>"><%= database.state %></span></td>
          <td class="numeric"><%= formatBytes(database.dataSizeBytes) %></td>
          <td class="numeric" title="<%= t('databases.table.logDetailsTitle', { count: formatNumber(database.logFileCount), reason: database.logReuseWait || '—' }) %>"><%= formatBytes(database.logSizeBytes) %></td>
          <td class="numeric"><%= formatBytes(database.totalSizeBytes) %></td>
          <td class="numeric"><%= database.activeConnections === null || database.activeConnections === undefined ? '—' : formatNumber(database.activeConnections) %></td>
          <td><%= database.recoveryModel || '—' %></td>
          <td><% if (database.lastFullBackupAt) { %><time datetime="<%= new Date(database.lastFullBackupAt).toISOString() %>"><%= formatDateTime(database.lastFullBackupAt) %></time><% } else { %>—<% } %></td>
          <td><div class="actions database-actions">
            <% if (canShrink) { %>
              <form class="action-with-tooltip" hx-post="/databases/shrink-log" hx-target="#operation-dialog-host" hx-swap="outerHTML"
                hx-confirm="<%= t('databases.shrink.safe.confirm', { databaseName: database.name }) %>"
                data-confirm-variant="warning" data-confirm-title="<%= t('databases.shrink.safe.title') %>" data-confirm-action="<%= t('databases.shrink.safe.action') %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="databaseName" value="<%= database.name %>">
                <input type="hidden" name="mode" value="safe"><input type="hidden" name="confirmShrinkLog" value="yes">
                <button class="button icon-button button--warning" type="submit" aria-label="<%= t('databases.shrink.safe.aria', { databaseName: database.name }) %>" aria-describedby="safe-shrink-tip-<%= databaseIndex %>">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><ellipse cx="12" cy="5" rx="7" ry="3"/><path d="M5 5v6c0 1.7 3.1 3 7 3s7-1.3 7-3V5M5 11v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"/><path d="m9 8 3 3 3-3"/></svg>
                </button>
                <span id="safe-shrink-tip-<%= databaseIndex %>" class="action-tooltip" role="tooltip"><%= t('databases.shrink.safe.tooltip') %></span>
              </form>
              <form class="action-with-tooltip" hx-post="/databases/shrink-log" hx-target="#operation-dialog-host" hx-swap="outerHTML"
                hx-confirm="<%= t('databases.shrink.aggressive.confirm', { databaseName: database.name }) %>"
                data-confirm-variant="danger" data-confirm-title="<%= t('databases.shrink.aggressive.title') %>" data-confirm-action="<%= t('databases.shrink.aggressive.action') %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="databaseName" value="<%= database.name %>">
                <input type="hidden" name="mode" value="aggressive"><input type="hidden" name="confirmShrinkLog" value="yes">
                <button class="button icon-button button--warning-strong" type="submit" aria-label="<%= t('databases.shrink.aggressive.aria', { databaseName: database.name }) %>" aria-describedby="aggressive-shrink-tip-<%= databaseIndex %>">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><ellipse cx="12" cy="5" rx="7" ry="3"/><path d="M5 5v6c0 1.7 3.1 3 7 3s7-1.3 7-3V5M5 11v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"/><path d="m8 8 4 4 4-4M9 13l3 3 3-3"/></svg>
                </button>
                <span id="aggressive-shrink-tip-<%= databaseIndex %>" class="action-tooltip" role="tooltip"><%= t('databases.shrink.aggressive.tooltip') %></span>
              </form>
            <% } %>
            <form class="action-with-tooltip" hx-post="/databases/delete" hx-target="#operation-dialog-host" hx-swap="outerHTML"
              hx-confirm="<%= t('databases.delete.confirm', { databaseName: database.name }) %>"
              data-confirm-variant="danger" data-confirm-title="<%= t('databases.delete.title') %>" data-confirm-action="<%= t('databases.delete.action') %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="databaseName" value="<%= database.name %>">
              <input type="hidden" name="confirmDelete" value="yes">
              <button class="button icon-button button--danger" type="submit" aria-label="<%= t('databases.delete.aria', { databaseName: database.name }) %>" aria-describedby="delete-tip-<%= databaseIndex %>">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h16M9 7V4h6v3M7 7l1 13h8l1-13M10 11v5M14 11v5"/></svg>
              </button>
              <span id="delete-tip-<%= databaseIndex %>" class="action-tooltip" role="tooltip"><%= t('databases.delete.tooltip') %></span>
            </form>
          </div></td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
<% if (oob) { %><span id="database-count" class="count-badge" hx-swap-oob="outerHTML"><%= databasesAvailable ? formatNumber(databaseDetails.length) : '—' %></span><% } %>
