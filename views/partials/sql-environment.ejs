<section id="sql-environment" class="sql-environment-section" aria-labelledby="sql-environment-heading">
  <div class="section-heading environment-heading">
    <div><h2 id="sql-environment-heading"><%= t('sqlEnvironment.title') %></h2><p><%= t('sqlEnvironment.description') %></p></div>
    <div class="section-tools">
      <div class="connection-status connection-status--<%= sqlEnvironment.connected ? 'connected' : 'disconnected' %>" role="status" aria-live="polite"><span class="connection-status__dot" aria-hidden="true"></span><%= t(sqlEnvironment.connected ? 'sqlEnvironment.connected' : 'sqlEnvironment.disconnected') %></div>
      <button class="refresh-button" type="button" title="<%= t('sqlEnvironment.refresh.title') %>" aria-label="<%= t('sqlEnvironment.refresh.aria') %>" hx-get="/partials/sql-environment" hx-target="#sql-environment" hx-swap="outerHTML"><span class="refresh-button__icon" aria-hidden="true">↻</span></button>
    </div>
  </div>
  <% if (sqlEnvironment.connected) { %>
    <dl class="environment-grid">
      <div><dt><%= t('sqlEnvironment.fields.serverInstance') %></dt><dd><%= sqlEnvironment.serverName || '—' %></dd></div>
      <div><dt><%= t('sqlEnvironment.fields.version') %> <a class="info-link" href="https://learn.microsoft.com/en-us/troubleshoot/sql/releases/download-and-install-latest-updates" target="_blank" rel="noopener noreferrer" title="<%= t('sqlEnvironment.versionHistory.title') %>" aria-label="<%= t('sqlEnvironment.versionHistory.aria') %>">i</a></dt><dd><% if (sqlEnvironment.releaseName) { %><%= sqlEnvironment.releaseName %> · <% } %><%= sqlEnvironment.productVersion || '—' %><% if (sqlEnvironment.productLevel) { %> (<%= sqlEnvironment.productLevel %>)<% } %></dd></div>
      <div><dt><%= t('sqlEnvironment.fields.edition') %></dt><dd><%= sqlEnvironment.edition || '—' %></dd></div><div><dt><%= t('sqlEnvironment.fields.host') %></dt><dd><%= sqlEnvironment.machineName || '—' %></dd></div>
      <div><dt><%= t('sqlEnvironment.fields.database') %></dt><dd><%= sqlEnvironment.databaseName || '—' %></dd></div><div><dt><%= t('sqlEnvironment.fields.login') %></dt><dd><%= sqlEnvironment.loginName || '—' %></dd></div>
      <div><dt><%= t('sqlEnvironment.fields.transport') %></dt><dd><%= sqlEnvironment.netTransport || '—' %></dd></div><div><dt><%= t('sqlEnvironment.fields.authentication') %></dt><dd><%= sqlEnvironment.authenticationScheme || '—' %></dd></div>
      <div><dt><%= t('sqlEnvironment.fields.target') %></dt><dd><%= sqlEnvironment.target ?? t('environment.notConfigured') %></dd></div>
    </dl>
  <% } else { %>
    <div class="environment-unavailable"><strong><%= t('sqlEnvironment.unavailable.title') %></strong><p><%= t('sqlEnvironment.unavailable.description', { target: sqlEnvironment.target ?? t('environment.notConfigured') }) %></p></div>
  <% } %>
</section>
